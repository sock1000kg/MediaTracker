{
  "name": "server",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "cross-env CHOKIDAR_USEPOLLING=true CHOKIDAR_INTERVAL=1000 tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "test": "npm run build && cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "seed": "node dist/tests/seed.js",
    "reset": "npx prisma migrate reset --force --skip-seed && npm run seed",
    "reset-test-db": "tsx src/tests/reset-test-db.ts",
    "db-test:start": "docker-compose -f ../docker-compose.test-db.yml up -d",
    "prod:start": "docker-compose -f ../docker-compose.yml up -d",
    "prod:rebuild": "docker-compose -f ../docker-compose.yml build --no-cache && docker-compose -f ../docker-compose.yml up -d",
    "dev:start": "docker-compose -f ../docker-compose.yml -f ../docker-compose.dev.yml up -d",
    "dev:rebuild": "docker-compose -f ../docker-compose.yml -f ../docker-compose.dev.yml build --no-cache && docker-compose -f ../docker-compose.yml -f ../docker-compose.dev.yml up -d"
  },
  "prisma": {
    "schema": "src/prisma/schema.prisma",
    "seed": "tsx src/tests/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.1",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "cross-env": "^10.0.0",
    "jest": "^30.0.5",
    "prisma": "^6.14.0",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
