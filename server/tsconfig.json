{
  "compilerOptions": {
    "target": "ES2020",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./",
    "noImplicitAny": false,
    "paths": {
      "@/*": ["src/*"],
      "@controllers/*": ["src/api/controllers/*"],
      "@routes/*": ["src/api/routes/*"],
      "@utils/*": ["src/utilities/*"],
      "@schemas/*": ["src/schemas/*"]
    }
  },
  "include": ["src/**/*",],
  "exclude": ["node_modules", "dist"],
}