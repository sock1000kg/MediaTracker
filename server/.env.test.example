# Test-only overrides. Anything not set here falls back to server/.env (see src/env.ts).
NODE_ENV=test
RATE_LIMIT_ENABLED=false

# Test database (PostgreSQL container in docker-compose.test-db.yml on host port 5433)
DATABASE_URL=postgresql://test_user:test_password@localhost:5433/mydb_test
POSTGRES_DB=mydb_test
POSTGRES_USER=test_user
POSTGRES_PASSWORD=test_password

# Optional: Valkey container in docker-compose.test-db.yml on host port 6380 (enables BullMQ contract tests)
# REDIS_URL_TEST=redis://localhost:6380
