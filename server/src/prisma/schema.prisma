// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum IdSource {
  openlibrary
  goodreads
  isbn
  isbn13
  lastfm
  musicbrainz
  anilist
  mal
  tmdb
  imdb
  letterboxd
  rawg
  bgg
  google_books
}

enum MediaSubtype {
  album
  track
  show
  season
}

enum LogStatus {
  wishlist
  completed
  in_progress @map("in progress")
  dropped
}

enum ApiKeyService {
  lastfm
  tmdb
  rawg
  bgg
}

model User {
  id              String        @id @default(uuid(7)) @db.Uuid
  username        String        @unique
  displayName     String        @default("")
  created_at      DateTime      @default(now())

  password        String
  preferences     Json          @default("{}")

  logs            UserLogs[]    @relation("UserLogsToUser")
  mediaType       MediaType[]   @relation("MediaTypesToUser")
  media           Media[]       @relation("MediaToUser")
  refreshToken    RefreshToken[] @relation("RefreshTokenToUser")

  apiKeys         UserAPIKey[]  @relation("APIToUser")
  tags            Tag[]         @relation("TagsToUser")
  collections     Collection[]  @relation("CollectionsToUser")
}

model Media {
  id              String        @id @default(uuid(7)) @db.Uuid
  title           String 
                            
                                                //book    music
  creator         String?                      //author  artist
  year            Int?
  subtype         MediaSubtype?
  releaseDate     DateTime?     @db.Date
  details         Json?           // strict per-subtype schema
  syncedAt        DateTime?       // last successful provider fetch (log, refresh, any job)
  syncCheckedAt   DateTime?       // last finished attempt, including "provider has no match"
  purgedAt        DateTime?       // TMDB 6-month purge
  created_at      DateTime      @default(now())

  provider        IdSource?   // IdSource; null = custom media
  providerId      String?     // external id from provider
  description     String?
  imageUrl        String?

  userId          String?       @db.Uuid
  user            User?         @relation(fields: [userId], references: [id], name: "MediaToUser", onDelete: Cascade)

  mediaTypeId     String?       @db.Uuid
  mediaType       MediaType?    @relation(fields: [mediaTypeId], references: [id], name: "MediaToMediaTypes", onDelete: Cascade)

  logs            UserLogs[]    @relation("UserLogsToMedia")

  parentId        String?       @db.Uuid
  parent          Media?        @relation("MediaChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children        Media[]       @relation("MediaChildren")
  position        Int?          // track number / season number
  externalIds     MediaExternalId[]
  originalTitle   String?
  genres          MediaGenre[]
  creators        MediaCreator[]

  @@index([parentId])
  @@index([provider, syncCheckedAt])
  @@unique([provider, providerId])
  @@unique([userId, creator, title, year, mediaTypeId], where: { provider: null })   // custom media
}

model Genre {
  id       String        @id @default(uuid(7)) @db.Uuid
  name     String        // as the provider returned it (first spelling seen)
  nameKey  String        @unique   // lower-case, trimmed, inner whitespace collapsed
  media    MediaGenre[]
}

model MediaGenre {
  mediaId  String        @db.Uuid
  genreId  String        @db.Uuid
  position Int           // provider order, used for "top 3" displays
  media    Media         @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  genre    Genre         @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([mediaId, genreId])
  @@index([genreId])
}

model Creator {
  id       String         @id @default(uuid(7)) @db.Uuid
  name     String
  nameKey  String         @unique   // lower-case, trimmed, whitespace collapsed
  media    MediaCreator[]
}

model MediaCreator {
  mediaId   String        @db.Uuid
  creatorId String        @db.Uuid
  role      String        // "author" | "artist" | "director" | "developer" | "studio" | "creator"
  position  Int
  media     Media         @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  creator   Creator       @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@id([mediaId, creatorId, role])
  @@index([creatorId])
}

model MediaExternalId {
  id         String   @id @default(uuid(7)) @db.Uuid
  mediaId    String   @db.Uuid
  media      Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  provider   IdSource // IdSource; external ids are only attached to system-owned rows
  externalId String
  created_at DateTime @default(now())

  @@unique([provider, externalId])
  @@index([mediaId])
}

model MediaType {
  id              String    @id @default(uuid(7)) @db.Uuid
  name            String    
  created_at      DateTime  @default(now())

  userId          String?   @db.Uuid
  user            User?     @relation(fields: [userId], references: [id], name: "MediaTypesToUser", onDelete: Cascade)

  media           Media[]   @relation("MediaToMediaTypes")

  @@unique([userId, name]) //One user have only unique mediaTypes
}


model UserLogs {
  id              String    @id @default(uuid(7)) @db.Uuid

  // The user's own name for this item ("The Stranger" while the media is "L'étranger"); max 300
  title           String?
  status          LogStatus?   // LogStatus enum: wishlist, completed, in_progress, dropped
  rating          Float?    //scale 100
  notes           String?
  logged_at       DateTime  @default(now())

  userId          String    @db.Uuid
  user            User      @relation(fields: [userId], references: [id], name: "UserLogsToUser", onDelete: Cascade)

  mediaId         String    @db.Uuid
  media           Media     @relation(fields: [mediaId], references: [id], name: "UserLogsToMedia", onDelete: Cascade)

  tags            LogTag[]  @relation("LogTagsToLog")
  collectionItems CollectionItem[] @relation("CollectionItemsToLog")
  entries         LogEntry[]

  @@unique([userId, mediaId]) //avoid duplicate logs of the same media for the same user
}

// One dated experience of an item: a read, watch, listen or play
model LogEntry {
  id                String    @id @default(uuid(7)) @db.Uuid
  logId             String    @db.Uuid
  log               UserLogs  @relation(fields: [logId], references: [id], onDelete: Cascade)
  startedAt         DateTime? @db.Date
  finishedAt        DateTime? @db.Date
  progressEpisodes  Int?
  progressChapters  Int?
  progressVolumes   Int?
  note              String?
  edition           Json?     // { title?, format?, language? }, validated by editionSchema
  created_at        DateTime  @default(now())

  @@index([logId, finishedAt])
}

model Tag {
  id              String    @id @default(uuid(7)) @db.Uuid
  userId          String    @db.Uuid
  user            User      @relation(fields: [userId], references: [id], name: "TagsToUser", onDelete: Cascade)
  name            String
  nameKey         String
  created_at      DateTime  @default(now())

  logs            LogTag[]  @relation("LogTagsToTag")

  @@unique([userId, nameKey])
}

model LogTag {
  logId           String    @db.Uuid
  tagId           String    @db.Uuid
  log             UserLogs  @relation(fields: [logId], references: [id], name: "LogTagsToLog", onDelete: Cascade)
  tag             Tag       @relation(fields: [tagId], references: [id], name: "LogTagsToTag", onDelete: Cascade)

  @@id([logId, tagId])
  @@index([tagId])
}

model Collection {
  id              String           @id @default(uuid(7)) @db.Uuid
  userId          String           @db.Uuid
  user            User             @relation(fields: [userId], references: [id], name: "CollectionsToUser", onDelete: Cascade)
  name            String
  nameKey         String
  description     String?
  ranked          Boolean          @default(false)
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt
  items           CollectionItem[] @relation("CollectionItemsToCollection")

  @@unique([userId, nameKey])
}

model CollectionItem {
  collectionId    String     @db.Uuid
  logId           String     @db.Uuid
  position        Int
  added_at        DateTime   @default(now())
  collection      Collection @relation(fields: [collectionId], references: [id], name: "CollectionItemsToCollection", onDelete: Cascade)
  log             UserLogs   @relation(fields: [logId], references: [id], name: "CollectionItemsToLog", onDelete: Cascade)

  @@id([collectionId, logId])
  @@index([logId])
}

model UserAPIKey {
  id              String         @id @default(uuid(7)) @db.Uuid
  key             String         // encrypted with encryptKey in server/src/utilities.ts
  service         ApiKeyService  // one of ApiKeyService; one key per user per service
  created_at      DateTime       @default(now())

  userId          String         @db.Uuid
  user            User           @relation(fields: [userId], references: [id], name: "APIToUser", onDelete: Cascade)

  @@unique([userId, service]) // one key per user per service
}

model RefreshToken {
  id        String   @id @default(uuid(7)) @db.Uuid
  tokenHash String   @unique // sha256 hex of the refresh token; the raw token is never stored
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], name: "RefreshTokenToUser", onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}
