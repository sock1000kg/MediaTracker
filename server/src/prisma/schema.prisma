// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              Int       @id @default(autoincrement())
  username        String    @unique
  displayName     String    @default("")
  created_at      DateTime  @default(now())

  password        String
  preferences     Json      @default("{}")

  logs            UserLogs[]@relation("UserLogsToUser")
  mediaType       MediaType[]@relation("MediaTypesToUser")
  media           Media[]@relation("MediaToUser")
  refreshToken    RefreshToken[]@relation("RefreshTokenToUser")

  apiKeys         UserAPIKey[]@relation("APIToUser")
  tags            Tag[]     @relation("TagsToUser")
  collections     Collection[] @relation("CollectionsToUser")
}

model Media {
  id              Int       @id @default(autoincrement())
  title           String 
                            
                                                //book    music
  creator         String?                      //author  artist
  year            Int?
  metadata        Json?
  created_at      DateTime  @default(now())

  source          String?
  sourceId        String?
  description     String?
  imageUrl        String?

  userId          Int?
  user            User?     @relation(fields: [userId], references: [id], name: "MediaToUser", onDelete: Cascade)

  mediaTypeId     Int?
  mediaType       MediaType? @relation(fields: [mediaTypeId], references: [id], name: "MediaToMediaTypes", onDelete: Cascade)

  logs            UserLogs[]@relation("UserLogsToMedia")

  @@unique([userId, creator, title, year, mediaTypeId, source]) //user only have 1 entry of one media
}

model MediaType {
  id              Int       @id @default(autoincrement())
  name            String    
  created_at      DateTime  @default(now())

  userId          Int?      
  user            User?     @relation(fields: [userId], references: [id], name: "MediaTypesToUser", onDelete: Cascade)

  media           Media[]   @relation("MediaToMediaTypes")

  @@unique([userId, name]) //One user have only unique mediaTypes
}


model UserLogs {
  id              Int       @id @default(autoincrement())


  status          String?   //"Completed" "In progress" "Wishlist" "Dropped"
  rating          Float?    //scale 100
  notes           String?
  started_at      DateTime?
  finished_at     DateTime?
  logged_at       DateTime  @default(now())

  userId          Int
  user            User      @relation(fields: [userId], references: [id], name: "UserLogsToUser", onDelete: Cascade)

  mediaId         Int
  media           Media     @relation(fields: [mediaId], references: [id], name: "UserLogsToMedia", onDelete: Cascade)

  tags            LogTag[]  @relation("LogTagsToLog")
  collectionItems CollectionItem[] @relation("CollectionItemsToLog")

  @@unique([userId, mediaId]) //avoid duplicate logs of the same media for the same user
}

model Tag {
  id              Int       @id @default(autoincrement())
  userId          Int
  user            User      @relation(fields: [userId], references: [id], name: "TagsToUser", onDelete: Cascade)
  name            String
  nameKey         String
  created_at      DateTime  @default(now())

  logs            LogTag[]  @relation("LogTagsToTag")

  @@unique([userId, nameKey])
}

model LogTag {
  logId           Int
  tagId           Int
  log             UserLogs  @relation(fields: [logId], references: [id], name: "LogTagsToLog", onDelete: Cascade)
  tag             Tag       @relation(fields: [tagId], references: [id], name: "LogTagsToTag", onDelete: Cascade)

  @@id([logId, tagId])
  @@index([tagId])
}

model Collection {
  id              Int              @id @default(autoincrement())
  userId          Int
  user            User             @relation(fields: [userId], references: [id], name: "CollectionsToUser", onDelete: Cascade)
  name            String
  nameKey         String
  description     String?
  ranked          Boolean          @default(false)
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt
  items           CollectionItem[] @relation("CollectionItemsToCollection")

  @@unique([userId, nameKey])
}

model CollectionItem {
  collectionId    Int
  logId           Int
  position        Int
  added_at        DateTime   @default(now())
  collection      Collection @relation(fields: [collectionId], references: [id], name: "CollectionItemsToCollection", onDelete: Cascade)
  log             UserLogs   @relation(fields: [logId], references: [id], name: "CollectionItemsToLog", onDelete: Cascade)

  @@id([collectionId, logId])
  @@index([logId])
}

model UserAPIKey {
  id              Int       @id @default(autoincrement())
  key             String    // store encrypted or plain (if it's safe)
  service         String    //"google_books"
  created_at      DateTime  @default(now())

  userId          Int
  user            User      @relation(fields: [userId], references: [id], name: "APIToUser", onDelete: Cascade)

  @@unique([userId, service]) // one key per user per service
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], name: "RefreshTokenToUser", onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}