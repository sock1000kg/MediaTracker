# Runtime
NODE_ENV=development
PORT=5000
VERSION=1.0.0
ALLOWED_CORS=http://localhost:5173
RATE_LIMIT_ENABLED=true

# Database
# Note: Docker Compose overrides DATABASE_URL with host 'database'
DATABASE_URL=postgresql://change-me:change-me@localhost:5432/mydb
POSTGRES_DB=mydb
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me

# Queue
# Valkey (Redis-compatible) for BullMQ job queue. Overridden by Docker Compose for the backend service.
REDIS_URL=redis://localhost:6379
QUEUE_DRIVER=
QUEUE_CONCURRENCY=2
QUEUE_WORKER=true

# Auth & secrets
REGISTER_KEY=change-me
JWT_KEY_SECRET=change-me-to-a-long-random-secret
JWT_REFRESH_SECRET=change-me-to-a-long-random-secret
API_KEY_SECRET=change-me-to-a-long-random-secret

# Providers
CONTACT_EMAIL=change-me@example.com

# Demo/seed
PUBLIC_DEMO=false
SYSTEM_USER_PASSWORD=change-me-system-password
DEMO_USER_PASSWORD=change-me-demo-password
LASTFM_API_KEY=change-me
TMDB_API_KEY=change-me
RAWG_API_KEY=change-me
