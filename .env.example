# DOCKER ENV
NODE_ENV=development
RATE_LIMIT_ENABLED=true
VERSION=version
ALLOWED_CORS=url1,url2,...

# @database if youre using docker compose
DATABASE_URL=postgresql://postgresUser:postgresUserCoolPass@database:5432/mydb

PORT=5000

# Valkey (Redis-compatible) for the BullMQ job queue. docker compose already sets this for the backend
# container; it's only needed here when running the server outside compose (e.g. redis://localhost:6379)
REDIS_URL=redis://valkey:6379
# bullmq | memory. Empty = auto (bullmq when REDIS_URL is set, else memory; memory is refused in production)
QUEUE_DRIVER=
# Max jobs processed in parallel by this process's worker
QUEUE_CONCURRENCY=2
# Run the job worker inside the API process (set false on the API when running a separate worker)
QUEUE_WORKER=true

REGISTER_KEY=register_key

# For Open Library api
CONTACT_EMAIL=your_mail

JWT_KEY_SECRET=replace_me_with_a_long_random_secret
JWT_REFRESH_SECRET=very_top_secret_secret_secret
API_KEY_SECRET=replace_me_with_a_long_random_secret

# For demo user seeding
LASTFM_API_KEY=your_lastfm_api_key
# Optional: TMDB API key or v4 read access token for the demo user (movie search)
TMDB_API_KEY=

# Optional: RAWG API key for the demo user (game search). Free key at https://rawg.io/apidocs
RAWG_API_KEY=

DEMO_USER_PASSWORD=Cool_pass_that_has_special_chars!_and_numbers123_and_upperCASE
SYSTEM_USER_PASSWORD=Cooler_pass_that_has_special_chars!_and_numbers123_upperCASE

POSTGRES_DB=mydb
POSTGRES_USER=postgresUser
POSTGRES_PASSWORD=postgresUserCooPass